[".config/bat/themes/Catppuccin-frappe.tmTheme"]
type = "file"
url = "https://raw.githubusercontent.com/catppuccin/bat/main/themes/Catppuccin%20Frappe.tmTheme"
[".config/delta/catppuccin.gitconfig"]
type = "file"
url = "https://raw.githubusercontent.com/catppuccin/delta/refs/heads/main/catppuccin.gitconfig"
[".config/micro/colorschemes/catppuchin-frappe.micro"]
type = "file"
url = "https://raw.githubusercontent.com/catppuccin/micro/main/themes/catppuccin-frappe.micro"
[".config/zsh/catppuccin_macchiato-zsh-syntax-highlighting.zsh"]
type = "file"
url = "https://raw.githubusercontent.com/catppuccin/zsh-syntax-highlighting/main/themes/catppuccin_macchiato-zsh-syntax-highlighting.zsh"
{{ if and (lookPath "op") (ne .chezmoi.os "windows") -}}
{{ $dropbox := .onepassword.items.dropbox -}}
["Library/Fonts/"]
type = "archive"
url = {{- includeTemplate "onepassword_url_label.tmpl" (dict "item" $dropbox.item "vault" $dropbox.vault "label" "private font download") | quote }}
include = ['**/*.otf', '**/*.ttf']
# Dropbox folder zips contain a bare "/" root entry that chezmoi rejects;
# re-pack through bsdtar, which strips it, and tell chezmoi the result is tar.
# chezmoi feeds the filter on a pipe, and bsdtar cannot read a zip from a
# non-seekable stream: without the central directory (stored at the end of the
# file) it falls back to streaming mode and emits every entry as 0 bytes. Spool
# stdin to a temp file first so bsdtar gets a seekable archive.
format = "tar"
filter.command = "sh"
filter.args = ["-c", 't=$(mktemp); trap "rm -f $t" EXIT; cat >"$t"; bsdtar -cf - --format=ustar @"$t"']
{{ end -}}
{{ if eq .chezmoi.os "windows" -}}
{{- /* Windows: clone public Claude Code marketplaces with system git.
  modify_known_marketplaces.json registers them; Claude Code then installs the
  enabledPlugins from settings.json. Private (SSH) marketplaces are cloned by
  run_onchange_after_clone-private-marketplaces instead: .claude applies before
  the 1Password agent.toml that exposes the SSH key, so an external would fail
  on a fresh machine. */ -}}
{{- $marketplaces := includeTemplate "claude_code_windows_marketplaces.tmpl" . | mustFromJson -}}
{{- range $name := keys $marketplaces | sortAlpha }}
{{- $cloneUrl := get (get $marketplaces $name) "clone_url" }}
{{- if not (hasPrefix "git@" $cloneUrl) }}
[".claude/plugins/marketplaces/{{ $name }}"]
type = "git-repo"
url = {{ $cloneUrl | quote }}
refreshPeriod = "168h"
{{ end -}}
{{ end -}}
{{ end -}}
