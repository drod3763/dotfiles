# Windows counterpart of macOS/run_once_before_90_bootstrap-age-identities.sh.tmpl.
# Fetches the age identities listed in onepassword.age_identities from 1Password
# so chezmoi can decrypt encrypted_ files. Keys are never written to the console.
$ErrorActionPreference = 'Stop'

function Write-BootstrapLog([string]$Message) {
  [Console]::Error.WriteLine("[age-bootstrap] $Message")
}

# Windows PowerShell 5.1 turns redirected native stderr into a terminating error
# under 'Stop', so native calls run under 'Continue' and are checked by exit code.
function Invoke-Native([scriptblock]$Command) {
  $previous = $ErrorActionPreference
  $ErrorActionPreference = 'Continue'
  try { (& $Command 2>$null | Out-String).Trim() } finally { $ErrorActionPreference = $previous }
}

# chezmoi exports its own path to scripts; fall back to PATH when run by hand.
$chezmoi = if ($env:CHEZMOI_EXECUTABLE) { $env:CHEZMOI_EXECUTABLE } else { 'chezmoi' }

{{ if not (lookPath "op") -}}
# Rendered without op on PATH. run_once keys on the rendered content, and this
# block disappears once op is installed, so the next chezmoi apply runs it again.
Write-BootstrapLog 'Skipping: 1Password CLI (op) is not installed; chezmoi apply will retry once it is.'
exit 0
{{ end -}}

$sources = @(
{{- range .onepassword.age_identities }}
  @{ Item = '{{ .item }}'; Vault = '{{ index $.onepassword.vaults .vault }}' }
{{- end }}
)

if ($sources.Count -eq 0) {
  Write-BootstrapLog 'No age identity sources found; nothing to bootstrap.'
  exit 0
}
Write-BootstrapLog "Found $($sources.Count) identity source(s)."

$ageDir = Join-Path $HOME '.config\chezmoi\age-identities'
New-Item -ItemType Directory -Force -Path $ageDir | Out-Null
# Equivalent of chmod 700, done before any key is written: drop inherited access
# so only this user can read the folder and the files created in it.
& icacls $ageDir /inheritance:r /grant:r "${env:USERNAME}:(OI)(CI)F" | Out-Null
if ($LASTEXITCODE -ne 0) { throw "icacls failed to restrict $ageDir (exit $LASTEXITCODE)" }

$identities = New-Object System.Collections.Generic.List[string]
$recipients = New-Object System.Collections.Generic.List[string]

$failed = New-Object System.Collections.Generic.List[string]

foreach ($source in $sources) {
  $label = "$($source.Item):$($source.Vault)"
  # op exits nonzero for a missing item or a denied prompt.
  $identity = Invoke-Native { op item get $source.Item --vault $source.Vault --fields credential --reveal }
  if ($LASTEXITCODE -ne 0 -or -not $identity) {
    Write-BootstrapLog "No credential returned for $label."
    $failed.Add($label)
    continue
  }

  # Only keep identities age can parse; the derived recipient doubles as the check.
  $tmp = [IO.Path]::GetTempFileName()
  try {
    [IO.File]::WriteAllText($tmp, "$identity`n")
    $recipient = Invoke-Native { & $chezmoi age-keygen -y $tmp }
    $parsed = ($LASTEXITCODE -eq 0 -and $recipient)
  } finally {
    Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
  }
  if (-not $parsed) {
    Write-BootstrapLog "Credential for $label is not a valid age identity."
    $failed.Add($label)
    continue
  }
  $identities.Add($identity)
  $recipients.Add($recipient)
}

# Write nothing unless every identity was fetched and valid, so a partial lookup
# (locked vault, denied prompt) never replaces a working keyring. Failing keeps
# this run_once script unrecorded, so the next chezmoi apply retries it.
if ($failed.Count -gt 0) {
  Write-BootstrapLog "Leaving existing identities untouched: $($failed.Count) of $($sources.Count) source(s) failed ($($failed -join ', ')). Unlock 1Password and re-run chezmoi apply."
  exit 1
}

# UTF-8 without BOM and LF endings, matching what age and the macOS files expect.
$utf8 = New-Object System.Text.UTF8Encoding($false)
$identitiesFile = Join-Path $ageDir 'identities.txt'
$recipientsFile = Join-Path $ageDir 'recipients.txt'
[IO.File]::WriteAllText($identitiesFile, (($identities | Select-Object -Unique) -join "`n") + "`n", $utf8)
[IO.File]::WriteAllText($recipientsFile, (($recipients | Select-Object -Unique) -join "`n") + "`n", $utf8)

Write-BootstrapLog "Wrote identities to $identitiesFile and recipients to $recipientsFile."
