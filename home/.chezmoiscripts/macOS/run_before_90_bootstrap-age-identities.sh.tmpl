#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '%s\n' "[age-bootstrap] $*" >&2
}

add_source() {
  local source="$1"
  local origin="$2"
  local item_id="${source%%:*}"
  local vault_id="${source##*:}"

  if [[ -z "${item_id}" || -z "${vault_id}" || "${item_id}" == "${vault_id}" ]]; then
    log "Ignoring malformed source from ${origin}: ${source}"
    return
  fi

  sources+=("${item_id}:${vault_id}")
}

if ! command -v op >/dev/null 2>&1; then
  log "Skipping: 1Password CLI (op) is not installed."
  exit 0
fi

if ! command -v chezmoi >/dev/null 2>&1; then
  log "Skipping: chezmoi is not installed."
  exit 0
fi

if ! command -v age >/dev/null 2>&1 && ! command -v rage >/dev/null 2>&1; then
  log "Missing required dependency: age or rage."
  echo "age or rage is required to decrypt chezmoi-managed secrets." >&2
  echo "Install age first, then re-run install.sh or chezmoi apply." >&2
  exit 1
fi

config_dir="${HOME}/.config/chezmoi"
age_dir="${config_dir}/age-identities"
items_file="${config_dir}/age-identities.items"
identities_file="${age_dir}/identities.txt"
recipients_file="${age_dir}/recipients.txt"

mkdir -p "${age_dir}"

declare -a sources=()

if [[ -n "${CHEZMOI_AGE_IDENTITY_ITEMS:-}" ]]; then
  log "Using CHEZMOI_AGE_IDENTITY_ITEMS environment override."
  IFS=',' read -r -a entries <<< "${CHEZMOI_AGE_IDENTITY_ITEMS}"
  for entry in "${entries[@]}"; do
    trimmed="$(printf '%s' "${entry}" | xargs)"
    [[ -n "${trimmed}" ]] || continue
    add_source "${trimmed}" "CHEZMOI_AGE_IDENTITY_ITEMS"
  done
else
  log "Checking target items file: ${items_file}"
  if [[ -f "${items_file}" ]]; then
    log "Target items file found."
  # shellcheck disable=SC2094
  while IFS= read -r line; do
    clean="$(printf '%s' "${line}" | sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')"
    [[ -n "${clean}" ]] || continue
    item_id="${clean%% *}"
    vault_id="${clean#* }"
    add_source "${item_id}:${vault_id}" "${items_file}"
  done < "${items_file}"
  else
    log "Target items file not found."
    source_items_file="$(chezmoi source-path "${items_file}" 2>/dev/null || true)"
    if [[ -z "${source_items_file}" ]]; then
      log "Could not resolve source path for items file."
    else
      log "Resolved source items path: ${source_items_file}"
    fi

    if [[ -n "${source_items_file}" && -f "${source_items_file}" ]]; then
      log "Source items file found."
    # shellcheck disable=SC2094
    while IFS= read -r line; do
      clean="$(printf '%s' "${line}" | sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')"
      [[ -n "${clean}" ]] || continue
      item_id="${clean%% *}"
      vault_id="${clean#* }"
      add_source "${item_id}:${vault_id}" "${source_items_file}"
    done < "${source_items_file}"
    else
      log "Source items file not found."
    fi
  fi
fi

if [[ ${#sources[@]} -eq 0 ]]; then
  log "No age identity sources found; nothing to bootstrap."
  exit 0
fi

log "Found ${#sources[@]} identity source(s)."

tmp_identities="$(mktemp)"
tmp_recipients="$(mktemp)"
trap 'rm -f "${tmp_identities}" "${tmp_recipients}"' EXIT

for source in "${sources[@]}"; do
  item_id="${source%%:*}"
  vault_id="${source##*:}"
  if [[ -z "${item_id}" || -z "${vault_id}" || "${item_id}" == "${vault_id}" ]]; then
    continue
  fi

  identity="$(op item get "${item_id}" --vault "${vault_id}" --fields credential --reveal 2>/dev/null || true)"
  if [[ -z "${identity}" ]]; then
    log "No credential returned for ${item_id}:${vault_id}; skipping."
    continue
  fi

  printf '%s\n' "${identity}" >> "${tmp_identities}"
  tmp_identity_file="$(mktemp)"
  printf '%s\n' "${identity}" > "${tmp_identity_file}"
  recipient="$(chezmoi age-keygen -y "${tmp_identity_file}" 2>/dev/null || true)"
  rm -f "${tmp_identity_file}"
  if [[ -n "${recipient}" ]]; then
    printf '%s\n' "${recipient}" >> "${tmp_recipients}"
  fi
done

if [[ ! -s "${tmp_identities}" ]]; then
  log "No identities written from ${#sources[@]} source(s); stopping to avoid downstream decryption failures."
  exit 1
fi

awk 'NF && !seen[$0]++' "${tmp_identities}" > "${identities_file}"
awk 'NF && !seen[$0]++' "${tmp_recipients}" > "${recipients_file}"
chmod 600 "${identities_file}" "${recipients_file}"
log "Wrote identities to ${identities_file} and recipients to ${recipients_file}."
