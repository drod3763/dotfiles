{{ if lookPath "moshi-hook" -}}
#!/bin/bash

set -euo pipefail

# Bring moshi-hook to a working state: agent hooks installed, host paired, E2EE on.
# Every step is driven by `moshi-hook status --json`, so a converged host does nothing.
# Pairing needs a phone to scan a QR code, so it is offered only on an interactive apply
# (stdin is a TTY) and defaults to "no" when the prompt is not answered in time.
moshi_pair_prompt_timeout="${MOSHI_PAIR_PROMPT_TIMEOUT:-30}"
moshi_status_retry_delay="${MOSHI_STATUS_RETRY_DELAY:-2}"

moshi_status() {
  moshi-hook status --json 2>/dev/null || true
}

moshi_status_valid() {
  [[ -n "${moshi_status_json}" ]] && jq -e . >/dev/null 2>&1 <<<"${moshi_status_json}"
}

moshi_field() {
  jq -r "$1" <<<"${moshi_status_json}" 2>/dev/null || true
}

moshi_status_json="$(moshi_status)"
if ! moshi_status_valid; then
  printf '%s\n' "moshi-hook status is unavailable; skipping Moshi setup." >&2
  exit 0
fi

# Agent hooks: `not_found` means that agent CLI is not installed; anything other than
# `current` (e.g. hooks removed when chezmoi rewrites ~/.config/claude/settings.json) needs a reinstall.
stale_hook_targets="$(jq -r '[.hooks[]? | select(.status != "current" and .status != "not_found") | .target] | join(",")' \
  <<<"${moshi_status_json}")"
if [[ -n "${stale_hook_targets}" ]]; then
  printf '%s\n' "Installing moshi-hook agent hooks for: ${stale_hook_targets}"
  if ! moshi-hook install --target "${stale_hook_targets}"; then
    printf '%s\n' "Failed to install moshi-hook hooks. Run: moshi-hook install" >&2
  fi
fi

# Advertise the tailnet name only while Tailscale is connected. With Tailscale SSH serving
# port 22, `host setup` warns that Remote Login is off and that its authorized_keys key goes
# unused; both are expected here (the tailnet ACL authorizes the phone), so --force past them.
# A stopped or logged-out backend keeps moshi's prerequisite checks in force. Called right
# before each use, so a prompt left open while Tailscale disconnects never reuses stale state.
build_moshi_setup_args() {
  moshi_setup_args=(host setup)
  command -v tailscale >/dev/null 2>&1 || return 0
  local status_json backend host run_ssh
  status_json="$(tailscale status --json 2>/dev/null || true)"
  backend="$(jq -r '.BackendState // empty' <<<"${status_json}" 2>/dev/null || true)"
  host="$(jq -r '.Self.DNSName // empty' <<<"${status_json}" 2>/dev/null || true)"
  host="${host%.}"
  if [[ "${backend}" == "Running" ]] && [[ -n "${host}" ]]; then
    moshi_setup_args+=(--host "${host}")
    run_ssh="$(tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || true)"
    if [[ "${run_ssh}" == "true" ]]; then
      moshi_setup_args+=(--force)
    fi
  fi
}

moshi_paired="$(moshi_field '.paired // false')"
moshi_paired_now=false
if [[ "${moshi_paired}" != "true" ]] && [[ -t 0 ]]; then
  # Only a submitted y/yes counts: a timeout, EOF, or an answer left unsubmitted is "no".
  pair_answer=""
  pair_confirmed=false
  printf '\nThis Mac is not paired with Moshi. Pair now? [y/N] (no in %ss) ' "${moshi_pair_prompt_timeout}"
  if read -r -t "${moshi_pair_prompt_timeout}" pair_answer && [[ "${pair_answer}" =~ ^([Yy]|[Yy][Ee][Ss])$ ]]; then
    pair_confirmed=true
  fi
  printf '\n'
  if [[ "${pair_confirmed}" == "true" ]]; then
    # Only a successful setup counts as this run's pairing: `paired` is host-wide, so a
    # failed setup that still finds the host paired (e.g. from another terminal) is not ours.
    moshi_setup_ok=false
    build_moshi_setup_args
    if moshi-hook "${moshi_setup_args[@]}"; then
      moshi_setup_ok=true
    else
      printf '%s\n' "Moshi pairing did not complete." >&2
    fi
    # The daemon restarts into a new pairing, so the status read can briefly fail; retry.
    moshi_status_json="$(moshi_status)"
    for _ in 1 2 3; do
      moshi_status_valid && break
      sleep "${moshi_status_retry_delay}"
      moshi_status_json="$(moshi_status)"
    done
    if [[ "${moshi_setup_ok}" == "true" ]] && ! moshi_status_valid; then
      printf '\n%s\n' "Moshi pairing finished, but its status could not be read to confirm it."
      printf '%s\n' "Check it with: moshi-hook status"
      printf '%s\n\n' "If it shows paired, turn on end-to-end encryption with: moshi-hook e2ee enable"
      exit 0
    fi
    moshi_paired="$(moshi_field '.paired // false')"
    if [[ "${moshi_setup_ok}" == "true" ]] && [[ "${moshi_paired}" == "true" ]]; then
      moshi_paired_now=true
    fi
  fi
fi

if [[ "${moshi_paired}" != "true" ]]; then
  build_moshi_setup_args
  printf '\n%s\n' "This Mac is not paired with Moshi. To pair it, run:"
  printf '  moshi-hook'
  printf ' %q' "${moshi_setup_args[@]}"
  printf '\n\n'
  exit 0
fi

# E2EE: enable it as part of a pairing this run made. On a host that was already paired,
# keep its policy: it may have been turned off on purpose (a phone without SSH access can't
# fetch the key and so can't approve), and an unattended apply must not undo that.
moshi_e2ee_policy="$(moshi_field '.e2ee.policy // empty')"
if [[ "${moshi_e2ee_policy}" != "on" ]]; then
  if [[ "${moshi_paired_now}" == "true" ]]; then
    printf '%s\n' "Enabling moshi-hook end-to-end encryption (each phone fetches the key over SSH)."
    if ! moshi-hook e2ee enable; then
      printf '%s\n' "Failed to enable moshi-hook E2EE. Run: moshi-hook e2ee enable" >&2
    fi
  else
    printf '%s\n' "Moshi end-to-end encryption is off on this Mac. To turn it on, run: moshi-hook e2ee enable"
  fi
fi
{{ end -}}
