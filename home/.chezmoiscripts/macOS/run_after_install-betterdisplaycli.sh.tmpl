#!/bin/bash

set -euo pipefail

{{ if not .personal -}}
if ! command -v brew >/dev/null 2>&1; then
  exit 0
fi

if [[ ! -d "/Applications/Xcode.app" ]]; then
  echo "Skipping betterdisplaycli install: Xcode is not installed yet."
  exit 0
fi

if brew list --formula betterdisplaycli >/dev/null 2>&1; then
  echo "betterdisplaycli is already installed."
  exit 0
fi

echo "Installing betterdisplaycli after Xcode install..."
brew install betterdisplaycli
{{ end -}}
