#!/usr/bin/env bash
set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
  exit 0
fi

mcp_file="${HOME}/.config/claude/mcp-servers.json"
claude_file="${HOME}/.config/claude/.claude.json"

if [[ ! -f "${mcp_file}" ]]; then
  exit 0
fi

mkdir -p "$(dirname "${claude_file}")"

if [[ ! -f "${claude_file}" ]] || ! jq -e . "${claude_file}" >/dev/null 2>&1; then
  printf '{}\n' > "${claude_file}"
fi

tmp_file="$(mktemp)"
trap 'rm -f "${tmp_file}"' EXIT

jq --slurpfile mcp "${mcp_file}" '.mcpServers = $mcp[0]' "${claude_file}" > "${tmp_file}"
mv "${tmp_file}" "${claude_file}"
chmod 600 "${claude_file}"
