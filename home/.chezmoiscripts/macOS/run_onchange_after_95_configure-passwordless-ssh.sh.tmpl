#!/bin/bash

set -euo pipefail

enable_passwordless_ssh="${CHEZMOI_ENABLE_PASSWORDLESS_SSH:-{{ get . "enablePasswordlessSsh" | default true }}}"
if [[ "${enable_passwordless_ssh}" != "true" ]]; then
  echo "Skipping passwordless SSH setup: enablePasswordlessSsh is not enabled."
  exit 0
fi

chezmoi_os="{{ .chezmoi.os }}"
if [[ "${chezmoi_os}" != "darwin" ]]; then
  echo "Skipping passwordless SSH setup: unsupported platform ${chezmoi_os}."
  exit 0
fi

authorized_keys="${CHEZMOI_SSH_AUTHORIZED_KEYS:-${HOME}/.ssh/authorized_keys}"
if [[ ! -s "${authorized_keys}" ]]; then
  echo "Cannot configure passwordless SSH: ${authorized_keys} is missing or empty." >&2
  exit 1
fi

sshd_config="${CHEZMOI_SSHD_CONFIG:-/etc/ssh/sshd_config}"
sshd_config_dir="${CHEZMOI_SSHD_CONFIG_DIR:-/etc/ssh/sshd_config.d}"
managed_config="${sshd_config_dir}/99-chezmoi-passwordless.conf"
sshd_bin="${CHEZMOI_SSHD_BIN:-/usr/sbin/sshd}"
ssh_keygen_bin="${CHEZMOI_SSH_KEYGEN_BIN:-/usr/bin/ssh-keygen}"
ssh_host_key_dir="${CHEZMOI_SSH_HOST_KEY_DIR:-/etc/ssh}"
systemsetup_bin="${CHEZMOI_SYSTEMSETUP_BIN:-/usr/sbin/systemsetup}"
launchctl_bin="${CHEZMOI_LAUNCHCTL_BIN:-/bin/launchctl}"
changed=false

# Rollback: disable enablePasswordlessSsh, remove ${managed_config}, restore
# ${sshd_config}.chezmoi-passwordless.bak if this script added the Include line,
# then validate and reload sshd.

run_as_root() {
  if [[ "${EUID}" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

write_if_changed() {
  local source_file="$1"
  local destination_file="$2"

  if [[ -f "${destination_file}" ]] && cmp -s "${source_file}" "${destination_file}"; then
    return 1
  fi

  run_as_root install -m 0644 "${source_file}" "${destination_file}"
  return 0
}

validate_sshd_config() {
  local config_file="$1"
  local output

  if [[ ! -x "${sshd_bin}" ]]; then
    echo "Skipping sshd config validation: ${sshd_bin} is unavailable."
    return 0
  fi

  # shellcheck disable=SC2310 # Validation failures are captured and classified below.
  if output="$(run_as_root "${sshd_bin}" -t -f "${config_file}" 2>&1)"; then
    return 0
  fi

  if [[ "${output}" == *"no hostkeys available"* ]]; then
    echo "Skipping sshd config validation failure: host keys are not available yet."
    return 0
  fi

  printf '%s\n' "${output}" >&2
  return 1
}

print_full_disk_access_instructions() {
  cat >&2 <<'EOF'
Cannot enable macOS Remote Login: the current terminal app needs Full Disk Access.

Grant Full Disk Access, then quit and reopen the terminal before running chezmoi again:
1. Open System Settings -> Privacy & Security -> Full Disk Access.
2. Enable Full Disk Access for the terminal app running chezmoi.
3. Quit and reopen that terminal app.
4. Run `chezmoi apply` again.

No SSH daemon configuration changes were applied.
EOF
}

preflight_remote_login_privileges() {
  local output remote_login_status

  if [[ ! -x "${systemsetup_bin}" ]]; then
    echo "Cannot check macOS Remote Login privileges: ${systemsetup_bin} is unavailable." >&2
    return 1
  fi

  remote_login_status="$(${systemsetup_bin} -getremotelogin 2>/dev/null || true)"
  if [[ "${remote_login_status}" == *"On"* ]]; then
    echo "Remote Login already enabled."
    return 0
  fi

  # shellcheck disable=SC2310 # Full Disk Access failures are reported with setup instructions.
  if output="$(run_as_root "${systemsetup_bin}" -setremotelogin on 2>&1)"; then
    echo "Enabled macOS Remote Login."
    changed=true
    return 0
  fi

  if [[ "${output}" == *"Full Disk Access"* ]]; then
    print_full_disk_access_instructions
    return 1
  fi

  printf '%s\n' "${output}" >&2
  return 1
}

ensure_host_keys() {
  local existing_host_keys=()
  shopt -s nullglob
  existing_host_keys=("${ssh_host_key_dir}"/ssh_host_*_key)
  shopt -u nullglob

  if (( ${#existing_host_keys[@]} > 0 )); then
    echo "SSH host keys already exist in ${ssh_host_key_dir}."
    return 0
  fi

  if [[ ! -x "${ssh_keygen_bin}" ]]; then
    echo "Cannot generate SSH host keys: ${ssh_keygen_bin} is unavailable." >&2
    return 1
  fi

  run_as_root "${ssh_keygen_bin}" -A
  echo "Generated missing SSH host keys."
}

enable_remote_login() {
  local remote_login_status

  if [[ -x "${systemsetup_bin}" ]]; then
    remote_login_status="$(${systemsetup_bin} -getremotelogin 2>/dev/null || true)"
    if [[ "${remote_login_status}" == *"On"* ]]; then
      echo "Remote Login already enabled."
      return 0
    fi

    run_as_root "${systemsetup_bin}" -setremotelogin on
    echo "Enabled macOS Remote Login."
    changed=true
    return 0
  else
    echo "Skipping systemsetup Remote Login enablement: ${systemsetup_bin} is unavailable."
  fi
}

config_tmp="$(mktemp)"
main_tmp="$(mktemp)"
cleanup() {
  rm -f "${config_tmp}" "${main_tmp}"
}
trap cleanup EXIT

preflight_remote_login_privileges

cat > "${config_tmp}" <<EOF
# Managed by chezmoi. See run_onchange_after_95_configure-passwordless-ssh.sh.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
AllowUsers {{ .chezmoi.username }}
MaxAuthTries 3
LoginGraceTime 20
X11Forwarding no
AllowAgentForwarding no
EOF

run_as_root mkdir -p "${sshd_config_dir}"
# shellcheck disable=SC2310 # An unchanged destination is reported via return 1.
if write_if_changed "${config_tmp}" "${managed_config}"; then
  echo "Updated SSH hardening config: ${managed_config}."
  changed=true
else
  echo "SSH hardening config already current: ${managed_config}."
fi

include_line="Include ${sshd_config_dir}/*.conf"
if [[ -f "${sshd_config}" ]] && grep -Eq "^[[:space:]]*Include[[:space:]]+${sshd_config_dir//\//\/}/\\*.conf([[:space:]]|$)" "${sshd_config}"; then
  echo "SSH daemon config already includes ${sshd_config_dir}."
else
  printf '%s\n\n' "${include_line}" > "${main_tmp}"
  if [[ -f "${sshd_config}" ]]; then
    cat "${sshd_config}" >> "${main_tmp}"
  fi

  if [[ -f "${sshd_config}" && ! -f "${sshd_config}.chezmoi-passwordless.bak" ]]; then
    run_as_root cp -p "${sshd_config}" "${sshd_config}.chezmoi-passwordless.bak"
  fi

  run_as_root install -m 0644 "${main_tmp}" "${sshd_config}"
  echo "Updated SSH daemon config include: ${sshd_config}."
  changed=true
fi

ensure_host_keys
validate_sshd_config "${sshd_config}"

enable_remote_login

if [[ "${changed}" == "true" && -x "${launchctl_bin}" ]]; then
  # shellcheck disable=SC2310 # Reload failure is non-fatal; the daemon can pick up changes later.
  if run_as_root "${launchctl_bin}" kickstart -k system/com.openssh.sshd; then
    echo "Reloaded macOS SSH daemon."
  else
    echo "SSH daemon reload was not available; changes will apply on next daemon start." >&2
  fi
fi

if [[ "${changed}" == "false" ]]; then
  echo "Passwordless SSH setup already configured."
fi
