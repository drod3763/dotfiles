#!/usr/bin/env bash
set -euo pipefail

# A child process cannot replace the user's parent shell session.
# Print a clear next step so the user can refresh their login shell.
if [[ -t 1 ]]; then
  printf '\n%s\n' "Bootstrap finished. Refresh your shell session:"
  printf '  %s\n\n' 'exec "$SHELL" -l'
fi
