#!/bin/bash

set -euo pipefail

{{ includeTemplate "sudo_helpers.tmpl" . }}

trap stop_sudo_keepalive EXIT

{{ if and (stat "/Applications/iTerm.app")
(and
(not (stat (expandenv "$HOME/.iterm2_shell_integration.zsh")))
(not (stat (expandenv "$HOME/.iterm2_shell_integration.bash")))) -}}
# iTerm2 Shell Integration
curl --location https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash
{{ end -}}

{{ if lookPath "tldr" -}}
# Update tldr db
tldr --update
{{ end -}}

{{ if or (lookPath "hammerspoon") (stat "/Applications/Hammerspoon.app") -}}
# Use XDG-style Hammerspoon config path
defaults write org.hammerspoon.Hammerspoon MJConfigFile "$HOME/.config/hammerspoon/init.lua"
{{ end -}}

{{ if lookPath "ya" -}}
if [[ ! -d "${HOME}/.config/yazi/flavors/catppuccin-mocha.yazi" ]]; then
  ya pkg add yazi-rs/flavors:catppuccin-mocha
fi
{{ end -}}

{{ if lookPath "tailscale" -}}
# Tailscale: register the root system daemon so tailscaled always runs at boot.
# `sudo brew services` installs to /Library/LaunchDaemons (root) — needed because default
# -tun utun requires root; a user-level service fails / freezes on sleep.
if [[ ! -f /Library/LaunchDaemons/homebrew.mxcl.tailscale.plist ]]; then
  with_sudo brew services start tailscale
fi
{{ end -}}

# Enable Touch ID / Apple Watch for sudo via /etc/pam.d/sudo_local.
if [[ -f /etc/pam.d/sudo_local.template ]]; then
  if [[ ! -f /etc/pam.d/sudo_local ]]; then
    with_sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
  fi

  if [[ -f /etc/pam.d/sudo_local ]] &&
    ! grep -qE '^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so([[:space:]]|$)' /etc/pam.d/sudo_local; then
    if grep -qE '^[[:space:]]*#?[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so([[:space:]]|$)' /etc/pam.d/sudo_local; then
      with_sudo sed -E -i '' 's/^[[:space:]]*#?[[:space:]]*(auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so)/\1/' /etc/pam.d/sudo_local
    else
      printf '%s\n' 'auth       sufficient     pam_tid.so' | with_sudo tee -a /etc/pam.d/sudo_local >/dev/null
    fi
  fi
fi

{{ if not .personal -}}
{{ $workDomain := .onepassword.items.work_domain -}}
{{ $corpLocalDomain := includeTemplate "onepassword_url_label.tmpl" (dict "item" $workDomain.item "vault" $workDomain.vault "label" "clients_local_domain") -}}
{{ if eq $corpLocalDomain "" -}}
{{ $corpLocalDomain = includeTemplate "onepassword_url_label.tmpl" (dict "item" $workDomain.item "vault" $workDomain.vault "label" "corp_local_domain") -}}
{{ end -}}
{{ if ne $corpLocalDomain "" -}}
if ! grep -qE '^[[:space:]]*127\.0\.0\.1[[:space:]]+{{ regexQuoteMeta $corpLocalDomain }}([[:space:]]|$)' /etc/hosts; then
  printf '%s\n' '127.0.0.1 {{ $corpLocalDomain }}' | with_sudo tee -a /etc/hosts >/dev/null
fi
{{ end -}}
{{ end -}}



{{ if not .personal -}}
{{  if lookPath "java" -}}
# Setup Java for Homebrew
with_sudo ln -sfn /opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk /Library/Java/JavaVirtualMachines/openjdk-11.jdk
{{  end -}}
{{ end -}}
