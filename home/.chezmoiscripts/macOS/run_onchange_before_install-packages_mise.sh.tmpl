#!/bin/bash

set -euo pipefail

{{ $packageCatalog := includeTemplate "package_catalog_resolver.tmpl" . | mustFromJson -}}
{{ $misePackages := ($packageCatalog.mise_packages | default (list)) -}}

{{ if gt (len $misePackages) 0 -}}
if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required to install packages marked with use_mise, but it was not found in PATH." >&2
  echo "Install mise first, then re-run chezmoi apply/install.sh." >&2
  exit 127
fi

if [[ -z "${MISE_SHELL:-}" ]]; then
  if ! mise_activation="$(mise activate bash)"; then
    echo "Failed to activate mise in this shell session." >&2
    exit 1
  fi
  eval "${mise_activation}"
fi

{{ range ($misePackages | sortAlpha | uniq) -}}
mise use --global "{{ . }}"
{{ end -}}
{{ end -}}
