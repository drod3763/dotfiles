#!/bin/bash

set -euo pipefail

{{ includeTemplate "sudo_helpers.tmpl" . }}

trap stop_sudo_keepalive EXIT
start_sudo_keepalive

# Ensure Homebrew is available even in non-interactive PATH contexts.
if ! command -v brew >/dev/null 2>&1; then
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    if brew_shellenv="$(/opt/homebrew/bin/brew shellenv)"; then
      eval "${brew_shellenv}"
    fi
  elif [[ -x "/usr/local/bin/brew" ]]; then
    if brew_shellenv="$(/usr/local/bin/brew shellenv)"; then
      eval "${brew_shellenv}"
    fi
  fi
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required but was not found in PATH." >&2
  echo "Install Homebrew first, then re-run chezmoi apply/install.sh." >&2
  exit 127
fi

{{ $packages := .packages.macos -}}
{{ $args := merge (dict) $packages.brew_args -}}
{{ $packageCatalog := includeTemplate "package_catalog_resolver.tmpl" . | mustFromJson -}}
{{ $resolved := (includeTemplate "rule_engine.tmpl" (dict
    "context" .
    "seed" (dict
      "taps" $packages.taps
      "brews" $packages.brews
      "casks" $packages.casks
      "mas" $packages.mas)
    "rules" $packages.rules
    "listKeys" (list "taps" "brews" "casks")
    "mapKeys" (list "mas")) | fromJson) -}}
{{ $taps := $resolved.taps -}}
{{ $brews := concat $resolved.brews ($packageCatalog.brew_formulas | default (list)) -}}
{{ $casks := concat $resolved.casks ($packageCatalog.brew_casks | default (list)) -}}
{{ $mas := $resolved.mas -}}
{{ range ($packageCatalog.mas_app_ids | default (list)) -}}
{{   $id := (int .) -}}
{{   $alreadyPresent := false -}}
{{   range (keys $mas | sortAlpha | uniq) -}}
{{     if contains (printf "id: %d" $id) (get $mas .) -}}
{{       $alreadyPresent = true -}}
{{     end -}}
{{   end -}}
{{   if not $alreadyPresent -}}
{{     $_ := set $mas (printf "Catalog app %d" $id) (printf ", id: %d" $id) -}}
{{   end -}}
{{ end -}}

max_attempts="${BREW_BUNDLE_MAX_ATTEMPTS:-3}"
attempt=1

while true; do
  if brew bundle --verbose --force --zap --file=/dev/stdin <<EOF
{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range ($brews | sortAlpha | uniq) -}}
{{ if eq . "felixkratz/formulae/borders" -}}
brew "felixkratz/formulae/borders", restart_service: true
{{ else -}}
brew "{{ . }}"{{get $args . }}
{{ end -}}
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
{{ if not .transient -}}
{{ range (keys $mas | sortAlpha | uniq) -}}
mas "{{ . }}"{{get $mas  . }}
{{ end -}}
{{ end -}}
EOF
  then
    break
  fi

  if [[ "${attempt}" -ge "${max_attempts}" ]]; then
    echo "brew bundle failed after ${attempt} attempts." >&2
    exit 1
  fi

  delay_seconds=$((attempt * 15))
  echo "brew bundle failed (attempt ${attempt}/${max_attempts}); retrying in ${delay_seconds}s..." >&2
  sleep "${delay_seconds}"
  attempt=$((attempt + 1))
done
