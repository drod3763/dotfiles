#!/bin/bash

set -euo pipefail

# Keep sudo alive only when credentials are already available.
if sudo -n true >/dev/null 2>&1; then
  while true; do sudo -n true; sleep 10; kill -0 "$$" || exit; done 2>/dev/null &
fi

# Ensure Homebrew is available even in non-interactive PATH contexts.
if ! command -v brew >/dev/null 2>&1; then
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required but was not found in PATH." >&2
  echo "Install Homebrew first, then re-run chezmoi apply/install.sh." >&2
  exit 127
fi

{{ $packages := .packages.macos -}}
{{ $args := merge (dict) $packages.brew_args -}}
{{ $resolved := (includeTemplate "rule_engine.tmpl" (dict
    "context" .
    "seed" (dict
      "taps" $packages.taps
      "brews" $packages.brews
      "casks" $packages.casks
      "mas" $packages.mas)
    "rules" $packages.rules
    "listKeys" (list "taps" "brews" "casks")
    "mapKeys" (list "mas")) | fromJson) -}}
{{ $taps := $resolved.taps -}}
{{ $brews := $resolved.brews -}}
{{ $casks := $resolved.casks -}}
{{ $mas := $resolved.mas -}}

max_attempts="${BREW_BUNDLE_MAX_ATTEMPTS:-3}"
attempt=1

while true; do
  if brew bundle --verbose --force --zap --file=/dev/stdin <<EOF
{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range ($brews | sortAlpha | uniq) -}}
{{ if eq . "felixkratz/formulae/borders" -}}
brew "felixkratz/formulae/borders", restart_service: true
{{ else -}}
brew "{{ . }}"{{get $args . }}
{{ end -}}
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
{{ if not .transient -}}
{{ range (keys $mas | sortAlpha | uniq) -}}
mas "{{ . }}"{{get $mas  . }}
{{ end -}}
{{ end -}}
EOF
  then
    break
  fi

  if [[ "${attempt}" -ge "${max_attempts}" ]]; then
    echo "brew bundle failed after ${attempt} attempts." >&2
    exit 1
  fi

  delay_seconds=$((attempt * 15))
  echo "brew bundle failed (attempt ${attempt}/${max_attempts}); retrying in ${delay_seconds}s..." >&2
  sleep "${delay_seconds}"
  attempt=$((attempt + 1))
done
