#!/bin/bash
# Must run before install-packages: `brew bundle cleanup --zap` removes Herdr Server.app,
# and a still-loaded KeepAlive agent would respawn-loop against the missing launcher.
set -euo pipefail

launchctl_bin="${CHEZMOI_LAUNCHCTL_BIN:-/bin/launchctl}"
target="gui/$(id -u)/local.herdr-server"

if "${launchctl_bin}" print "${target}" >/dev/null 2>&1; then
  "${launchctl_bin}" bootout "${target}" >/dev/null 2>&1 || true
  printf '%s\n' "herdr: unloaded local.herdr-server."
fi
