#!/bin/bash

set -euo pipefail

label="local.tailnet-routes"
helper="${CHEZMOI_TAILNET_ROUTES_HELPER:-/usr/local/libexec/tailnet-routes}"
plist="${CHEZMOI_TAILNET_ROUTES_PLIST:-/Library/LaunchDaemons/${label}.plist}"
launchctl_bin="${CHEZMOI_LAUNCHCTL_BIN:-/bin/launchctl}"

run_as_root() {
  if [[ "${EUID}" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

{{ if .personal -}}
if [[ -f "${plist}" || -f "${helper}" ]]; then
  run_as_root "${launchctl_bin}" bootout "system/${label}" >/dev/null 2>&1 || true
  run_as_root rm -f "${plist}" "${helper}"
  echo "Removed ${label}."
fi
exit 0
{{- else -}}
helper_tmp="$(mktemp)"
plist_tmp="$(mktemp)"
trap 'rm -f "${helper_tmp}" "${plist_tmp}"' EXIT

# Another VPN on this Mac can claim all of 100.64.0.0/10, which swallows tailnet traffic.
# A host route per peer is more specific, so it wins.
cat > "${helper_tmp}" <<'EOF'
#!/bin/bash
set -euo pipefail

tailscale_bin="${TAILNET_ROUTES_TAILSCALE_BIN:-{{ lookPath "tailscale" | default "/opt/homebrew/bin/tailscale" }}}"
route_bin="${TAILNET_ROUTES_ROUTE_BIN:-/sbin/route}"
ifconfig_bin="${TAILNET_ROUTES_IFCONFIG_BIN:-/sbin/ifconfig}"
# Cleared at boot, like the routes it tracks.
state_file="${TAILNET_ROUTES_STATE_FILE:-/var/run/local.tailnet-routes.peers}"

# launchd's PATH lacks Homebrew, and /usr/bin/jq only ships with newer macOS.
jq_bin="${TAILNET_ROUTES_JQ_BIN:-}"
if [[ -z "${jq_bin}" ]]; then
  for candidate in /usr/bin/jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
    if [[ -x "${candidate}" ]]; then
      jq_bin="${candidate}"
      break
    fi
  done
fi
if [[ ! -x "${jq_bin}" ]]; then
  echo "tailnet-routes: jq not found; cannot read tailnet peers." >&2
  exit 1
fi

self_ip="$("${tailscale_bin}" ip -4 2>/dev/null | head -n 1 || true)"
if [[ -z "${self_ip}" ]]; then
  exit 0
fi

# The utun number is not stable across tailscaled restarts, so find it by address.
ts_if="$("${ifconfig_bin}" | awk -v ip="${self_ip}" '
  /^[a-z]/ { iface = $1; sub(/:$/, "", iface) }
  $1 == "inet" && $2 == ip { print iface; exit }
')"
if [[ -z "${ts_if}" ]]; then
  exit 0
fi

# An unreadable status must not look like an empty tailnet, or every owned route is pruned.
if ! peers="$("${tailscale_bin}" status --json 2>/dev/null |
  "${jq_bin}" -r '(.Peer // {})[].TailscaleIPs[]? | select(test("^[0-9.]+$"))' 2>/dev/null)"; then
  exit 0
fi

previous="$(cat "${state_file}" 2>/dev/null || true)"
owned=""
failed=0

route_iface() {
  "${route_bin}" -n get "$1" 2>/dev/null | awk '/interface:/ { print $2 }'
}

# Only this helper adds per-peer host routes on the Tailscale interface, so those are ours,
# including ones added before ownership was tracked.
owns_host_route() {
  "${route_bin}" -n get "$1" 2>/dev/null | awk -v ts="${ts_if}" '
    /interface:/ { iface = $2 }
    /flags:/ { host = ($0 ~ /HOST/) }
    END { exit !(iface == ts && host) }
  '
}

while IFS= read -r peer; do
  [[ -n "${peer}" ]] || continue
  current="$(route_iface "${peer}")"
  if [[ "${current}" == "${ts_if}" ]]; then
    if owns_host_route "${peer}"; then
      owned+="${peer}"$'\n'
    fi
    continue
  fi
  "${route_bin}" -n delete -host "${peer}" >/dev/null 2>&1 || true
  if "${route_bin}" -n add -host "${peer}" -interface "${ts_if}" >/dev/null; then
    owned+="${peer}"$'\n'
    echo "Routed ${peer} via ${ts_if} (was ${current:-none})."
  else
    echo "Failed to route ${peer} via ${ts_if}." >&2
    failed=1
  fi
done <<<"${peers}"

# Keep a departed peer owned until its route is really gone, so the next run retries.
while IFS= read -r peer; do
  [[ -n "${peer}" ]] || continue
  grep -qxF "${peer}" <<<"${peers}" && continue
  "${route_bin}" -n delete -host "${peer}" >/dev/null 2>&1 || true
  if owns_host_route "${peer}"; then
    owned+="${peer}"$'\n'
    echo "Failed to remove route for departed peer ${peer}." >&2
    failed=1
  else
    echo "Removed route for departed peer ${peer}."
  fi
done <<<"${previous}"

printf '%s' "${owned}" >"${state_file}.tmp"
mv -f "${state_file}.tmp" "${state_file}"
exit "${failed}"
EOF

cat > "${plist_tmp}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${helper}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>WatchPaths</key>
  <array>
    <string>/Library/Preferences/SystemConfiguration</string>
  </array>
  <key>StandardOutPath</key>
  <string>/var/log/${label}.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/${label}.log</string>
</dict>
</plist>
EOF

run_as_root mkdir -p "$(dirname "${helper}")"
run_as_root install -m 0755 "${helper_tmp}" "${helper}"
run_as_root install -m 0644 "${plist_tmp}" "${plist}"

run_as_root "${launchctl_bin}" bootout "system/${label}" >/dev/null 2>&1 || true
run_as_root "${launchctl_bin}" bootstrap system "${plist}"
echo "Loaded ${label}."
{{- end }}
