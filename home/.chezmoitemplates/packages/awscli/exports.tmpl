{{- $exports := dict -}}
{{- if not .personal -}}
{{-   $exports = merge $exports (dict
      "AWS_PROFILE" "arcus_dev"
      "AWS_SDK_LOAD_CONFIG" "1") -}}
{{- end -}}
{{- $exports = merge $exports (dict
    "AWS_SHARED_CREDENTIALS_FILE" "${XDG_CONFIG_HOME}/aws/credentials"
    "AWS_CONFIG_FILE" "${XDG_CONFIG_HOME}/aws/config") -}}
{{- dict "exports" $exports | toJson -}}
