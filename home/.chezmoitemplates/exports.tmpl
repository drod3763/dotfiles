{{ $exports := merge (dict) .exports.common -}}
{{ $exports = merge $exports (dict
    "DOTFILES" .chezmoi.sourceDir
    "OPENAI_API_KEY" ((index (onepassword "d2sclj2vlu5y55x7ojx3uzm3tq" "ydxim6il3bd3reztx5kioejcmu").fields 2).value)
    "OP_SERVICE_ACCOUNT_TOKEN" ((index (onepassword "pwvya36g66yls5o5zj7tcrqaci" "ylehyg24v4ktnhshngeyvl4fye").fields 2).value)) -}}

{{ range .exports.rules -}}
{{   $ok := true -}}
{{   if and $ok (hasKey . "when_os") -}}
{{     if ne $.chezmoi.os .when_os -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_shell") -}}
{{     if ne $.shell .when_shell -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_tool") -}}
{{     if not (lookPath .when_tool) -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_tools") -}}
{{     range .when_tools -}}
{{       if not (lookPath .) -}}
{{         $ok = false -}}
{{       end -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_not_personal") -}}
{{     if and .when_not_personal $.personal -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_personal") -}}
{{     if and .when_personal (not $.personal) -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if and $ok (hasKey . "when_stat") -}}
{{     if not (stat .when_stat) -}}
{{       $ok = false -}}
{{     end -}}
{{   end -}}
{{   if $ok -}}
{{     $exports = merge $exports .values -}}
{{   end -}}
{{ end -}}

{{ if lookPath "dotnet" -}}
{{   $dotnetRoot := "/opt/homebrew/opt/dotnet/libexec" -}}
{{   if stat "/opt/homebrew/opt/dotnet@8/libexec" -}}
{{     $dotnetRoot = "/opt/homebrew/opt/dotnet@8/libexec" -}}
{{   end -}}
{{   $exports = merge $exports (dict
      "DOTNET_CLI_HOME" "${XDG_CONFIG_HOME}/dotnet"
      "DOTNET_CLI_TELEMETRY_OPTOUT" "true"
      "DOTNET_ROOT" $dotnetRoot) -}}
{{ end -}}

{{ if and (eq .chezmoi.os "darwin") (stat "${HOME}/Library/Python/") -}}
{{   $exports = merge $exports (dict
      "PYTHONPYCACHEPREFIX" "${XDG_CACHE_HOME}/python"
      "PYTHON_HOMES" "(${HOME}/Library/Python/*)"
      "PYTHON_HOME" "${PYTHON_HOMES}[0]"
      "PYTHONPATH" "${HOME}/.python"
      "PYTHONUSERBASE" "${XDG_DATA_HOME}/python") -}}
{{ end -}}

{{ range (keys $exports | sortAlpha | uniq) -}}
export {{ . }}={{ get $exports . | quote }}
{{ end -}}
