{{ $exportsData := (get . "exports" | default (dict)) -}}
{{ $exportCommon := (get $exportsData "common" | default (dict)) -}}
{{ $exportRules := (get $exportsData "rules" | default (list)) -}}
{{ $exports := merge (dict) $exportCommon -}}
{{ $packageCatalog := includeTemplate "package_catalog_resolver.tmpl" . | mustFromJson -}}
{{ $activePackageNames := ($packageCatalog.active_packages | default (list)) -}}
{{ $shellManifest := includeTemplate "shell_manifest_renderer.tmpl" . | mustFromJson -}}
{{ $exports = merge $exports ($shellManifest.exports | default (dict)) -}}

{{ $exportOwners := dict -}}
{{ range (keys $exports | sortAlpha | uniq) -}}
{{   $_ := set $exportOwners . "base" -}}
{{ end -}}

{{ range ($activePackageNames | sortAlpha | uniq) -}}
{{   $packageName := . -}}
{{   $templateName := printf "packages/%s/exports.tmpl" $packageName -}}
{{   $sourcePath := joinPath $.chezmoi.sourceDir ".chezmoitemplates" $templateName -}}
{{   if stat $sourcePath -}}
{{     $packageData := includeTemplate $templateName $ | mustFromJson -}}
{{     $packageExports := ($packageData.exports | default (dict)) -}}
{{     range (keys $packageExports | sortAlpha | uniq) -}}
{{       $key := . -}}
{{       $owner := (get $exportOwners $key | default "") -}}
{{       if and (ne $owner "") (ne $owner "base") (ne $owner $packageName) -}}
{{         fail (printf "duplicate export key %q from package %q already owned by %q" $key $packageName $owner) -}}
{{       end -}}
{{       $_ := set $exportOwners $key $packageName -}}
{{       $_ := set $exports $key (get $packageExports $key) -}}
{{     end -}}
{{   end -}}
{{ end -}}

{{ $exports = (includeTemplate "rule_engine.tmpl" (dict
    "context" .
    "seed" $exports
    "rules" $exportRules
    "valueKey" "values") | fromJson) -}}

{{ range (keys $exports | sortAlpha | uniq) -}}
export {{ . }}={{ get $exports . | quote }}
{{ end -}}
