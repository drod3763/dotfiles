{{ $exports := merge (dict) .exports.common -}}
{{ $openai := .onepassword.items.openai_key -}}
{{ $serviceAccount := .onepassword.items.service_account_token -}}
{{ $exports = merge $exports (dict
    "DOTFILES" .chezmoi.sourceDir
    "OPENAI_API_KEY" (includeTemplate "onepassword_field.tmpl" (dict "item" $openai.item "vault" $openai.vault "field_id" $openai.fields.credential))
    "OP_SERVICE_ACCOUNT_TOKEN" (includeTemplate "onepassword_field.tmpl" (dict "item" $serviceAccount.item "vault" $serviceAccount.vault "field_id" $serviceAccount.fields.credential))) -}}
{{ $exports = (includeTemplate "rule_engine.tmpl" (dict
    "context" .
    "seed" $exports
    "rules" .exports.rules
    "valueKey" "values") | fromJson) -}}

{{ if lookPath "dotnet" -}}
{{   $dotnetRoot := "/opt/homebrew/opt/dotnet/libexec" -}}
{{   if stat "/opt/homebrew/opt/dotnet@8/libexec" -}}
{{     $dotnetRoot = "/opt/homebrew/opt/dotnet@8/libexec" -}}
{{   end -}}
{{   $exports = merge $exports (dict
      "DOTNET_CLI_HOME" "${XDG_CONFIG_HOME}/dotnet"
      "DOTNET_CLI_TELEMETRY_OPTOUT" "true"
      "DOTNET_ROOT" $dotnetRoot) -}}
{{ end -}}

{{ if and (eq .chezmoi.os "darwin") (stat "${HOME}/Library/Python/") -}}
{{   $exports = merge $exports (dict
      "PYTHONPYCACHEPREFIX" "${XDG_CACHE_HOME}/python"
      "PYTHON_HOMES" "(${HOME}/Library/Python/*)"
      "PYTHON_HOME" "${PYTHON_HOMES}[0]"
      "PYTHONPATH" "${HOME}/.python"
      "PYTHONUSERBASE" "${XDG_DATA_HOME}/python") -}}
{{ end -}}

{{ range (keys $exports | sortAlpha | uniq) -}}
export {{ . }}={{ get $exports . | quote }}
{{ end -}}
