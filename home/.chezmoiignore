{{- $ignoreData := (.chezmoiignore | default (dict)) -}}
{{- $ignore := (get $ignoreData "base" | default (list)) -}}

{{- if ne .chezmoi.os "darwin" }}
    {{- $ignore = concat $ignore (get $ignoreData "not_darwin" | default (list)) -}}
{{- end }}

{{- if ne .chezmoi.os "linux" }}
    {{- $ignore = concat $ignore (get $ignoreData "not_linux" | default (list)) -}}
{{- end }}

{{- $packageCatalog := includeTemplate "package_catalog_resolver.tmpl" . | mustFromJson -}}
{{- range ($packageCatalog.inactive_config_paths | default (list)) -}}
    {{- $ignore = concat $ignore (list .) -}}
{{- end -}}

{{- if and (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) (ne .shell "zsh") -}}
    {{- $ignore = concat $ignore (get $ignoreData "non_zsh_shell" | default (list)) -}}
{{- else if ne .shell "bash" }}
    {{- $ignore = concat $ignore (get $ignoreData "non_bash_shell" | default (list)) -}}
{{- end }}

{{- if ne .chezmoi.os "windows" }}
    {{- $ignore = concat $ignore (get $ignoreData "not_windows" | default (list)) -}}
{{- else }}
    {{- $ignore = concat $ignore (get $ignoreData "windows" | default (list)) -}}
{{- end -}}

{{- range ($ignore | sortAlpha | uniq) -}}
{{ . }}
{{ end -}}
