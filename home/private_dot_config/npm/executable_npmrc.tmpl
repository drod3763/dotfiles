prefix=${XDG_DATA_HOME}/npm
cache=${XDG_CACHE_HOME}/npm
tmp=${XDG_RUNTIME_DIR}/npm
init-module=${XDG_CONFIG_HOME}/npm/config/npm-init.js
{{- $packaging := .onepassword.items.packaging_token -}}
{{- $workDomain := .onepassword.items.work_domain -}}
{{- $registryURL := includeTemplate "onepassword_field.tmpl" (dict "item" $packaging.item "vault" $packaging.vault "field_id" $packaging.fields.npm_registry_url) -}}
{{- $username := includeTemplate "onepassword_field.tmpl" (dict "item" $packaging.item "vault" $packaging.vault "field_id" $packaging.fields.username) -}}
{{- $password := includeTemplate "onepassword_field.tmpl" (dict "item" $packaging.item "vault" $packaging.vault "field_id" $packaging.fields.credential) -}}
{{- $email := includeTemplate "onepassword_field.tmpl" (dict "item" $workDomain.item "vault" $workDomain.vault "field_id" $workDomain.fields.username) -}}
; begin auth token
{{ $registryURL -}}registry/:username={{- $username }}
{{ $registryURL -}}registry/:_password={{- b64enc $password }}
{{ $registryURL -}}registry/:email={{- $email }}
{{ $registryURL -}}:username={{- $username }}
{{ $registryURL -}}:_password={{- b64enc $password }}
{{ $registryURL -}}:email={{- $email }}
