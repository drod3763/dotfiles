{{- /* Personal Zsh configuration (vanilla zsh; plugins sourced from Homebrew).
Shell behavior is defined in home/.chezmoidata/shell_manifest/**.toml and rendered
into $ZDOTDIR/sections/*.zsh. Keep customization there, not inline here. */ -}}
# Powerlevel10k instant prompt. Must stay close to the top of .zshrc; console
# output before it (e.g. echo) breaks the instant prompt. The real theme is loaded
# from the init section below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

{{ if eq .chezmoi.os "darwin" -}}
# Ensure HOMEBREW_PREFIX et al. are set before the PATH section uses them.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -x /usr/local/bin/brew ]] && eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}

# Source a file, compiling it to a .zwc bytecode cache first for faster startup
# (replaces z4h's `z4h source --compile`).
_zsh_source() {
  local f=$1
  [[ -r $f ]] || return
  if [[ ! -e $f.zwc || $f -nt $f.zwc ]]; then
    zcompile -R -- $f.zwc $f 2>/dev/null
  fi
  source $f
}

# Export environment variables, then extend PATH.
_zsh_source "$ZDOTDIR/sections/exports.zsh"
_zsh_source "$ZDOTDIR/sections/path.zsh"

# Autoload functions.
autoload -Uz zmv

# Functions and aliases.
_zsh_source "$ZDOTDIR/sections/functions.zsh"
_zsh_source "$ZDOTDIR/sections/aliases.zsh"

# History. z4h used to configure these; set them explicitly now.
HISTFILE="$ZDOTDIR/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

# Shell options. Reproduces the set z4h enabled by default, plus local overrides.
setopt auto_cd auto_pushd pushd_ignore_dups pushd_silent  # smarter cd / dir stack
setopt extended_glob glob_dots no_case_glob               # globbing
setopt always_to_end auto_param_slash no_auto_remove_slash
setopt interactive_comments multios no_beep no_flow_control c_bases
setopt no_auto_menu                                       # extra TAB to open menu
setopt hash_list_all                                      # rehash command list
setopt extended_history hist_verify hist_reduce_blanks
setopt hist_ignore_dups hist_ignore_space hist_find_no_dups
setopt hist_save_no_dups hist_expire_dups_first
setopt append_history inc_append_history share_history
chpwd() { ll }

# Completion, plugins and prompt, ordered by manifest priority. This is the only
# place plugins are sourced (zsh-syntax-highlighting renders last, followed by
# zsh-history-substring-search per its required load order). ZLE widgets are
# defined here too.
_zsh_source "$ZDOTDIR/sections/init.zsh"

# Key bindings. Included after init.zsh so every widget it binds already exists.
{{ template "bindkeys.tmpl" . }}
