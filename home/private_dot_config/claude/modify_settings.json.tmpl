#!/usr/bin/env bash
set -euo pipefail

# Claude Code and other tools (moshi-hook, /model, /plugin) write into settings.json and
# reorder its keys. Template-defined keys win; everything else in the live file is kept, and
# hook groups added by other tools are appended to the managed ones. When the merge changes
# nothing but key order, the live file is passed through untouched so `chezmoi diff` stays clean.
#
# Each real apply (targeted ones included; never diff, status or --dry-run) records the key values
# and hook groups the template has managed in an append-only ownership file outside settings.json.
# Owned entries the template no longer defines are removed when the live file still holds an
# owned value, so retired plugins and replaced hooks don't linger, while values edited locally
# and entries from other tools stay.

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

managed_file="${tmp_dir}/managed.json"
live_file="${tmp_dir}/live.json"
merged_file="${tmp_dir}/merged.json"
owned_file="${CLAUDE_SETTINGS_OWNERSHIP:-{{ .chezmoi.homeDir }}/.local/state/chezmoi/claude-settings.owned.json}"
previous_owned_file="${tmp_dir}/previous-owned.json"
owned_next_file="${tmp_dir}/owned.json"

cat >"${managed_file}" <<'CLAUDE_SETTINGS_JSON'
{{ includeTemplate "claude_code_settings.json.tmpl" . | trim }}
CLAUDE_SETTINGS_JSON

cat >"${live_file}"

record_ownership() {
  if [[ -s "${owned_file}" ]] && jq -e 'type == "object"' "${owned_file}" >/dev/null 2>&1; then
    cat "${owned_file}" >"${previous_owned_file}"
  else
    printf '{}\n' >"${previous_owned_file}"
  fi

  # Ownership: {"keys": {"<json path>": [values ever managed]}, "hooks": {"<event>": [groups ever managed]}}.
  jq -n \
    --slurpfile previous "${previous_owned_file}" \
    --slurpfile managed "${managed_file}" '
    $managed[0] as $m
    | {keys: ($previous[0].keys // {}), hooks: ($previous[0].hooks // {})}
    | reduce ($m | paths(type != "object") | select(all(.[]; type == "string")) | select(.[0] != "hooks")) as $k (.;
        .keys[$k | tojson] = ((.keys[$k | tojson] // []) + [$m | getpath($k)] | unique))
    | reduce (($m.hooks // {}) | to_entries[] | select(.value | type == "array")) as $event (.;
        .hooks[$event.key] = ((.hooks[$event.key] // []) + $event.value | unique))
  ' >"${owned_next_file}"

  # Both helpers check each step and return explicitly, so running them without set -e is fine.
  # shellcheck disable=SC2310
  if is_real_apply && ! jq -e -n --slurpfile a "${previous_owned_file}" --slurpfile b "${owned_next_file}" '$a[0] == $b[0]' >/dev/null; then
    # shellcheck disable=SC2310
    if ! persist_ownership; then
      printf '%s\n' "claude settings.json: could not record ownership in ${owned_file}; retired entries may linger." >&2
    fi
  fi
}

# Only an apply that writes files may claim ownership; diff, status and --dry-run previews
# must not, or a previewed branch could later retire a matching local setting.
is_real_apply() {
  case "${CHEZMOI_COMMAND:-}" in
    apply | init | update) ;;
    *) return 1 ;;
  esac
  local arg
  for arg in ${CHEZMOI_ARGS:-}; do
    case "${arg}" in
      --dry-run | --dry-run=true) return 1 ;;
      --*) ;;
      -*n*) return 1 ;;
      *) ;;
    esac
  done
  return 0
}

# Re-read, merge and publish under a lock so concurrent runs can't drop each other's additions.
persist_ownership() {
  local owned_dir lock_dir attempt staged
  owned_dir="$(dirname "${owned_file}")"
  lock_dir="${owned_file}.lock"
  mkdir -p "${owned_dir}" || return 1
  for attempt in $(seq 1 50); do
    if mkdir "${lock_dir}" 2>/dev/null; then
      break
    fi
    if [[ "${attempt}" -eq 50 ]]; then
      return 1
    fi
    sleep 0.1
  done
  staged="$(mktemp "${owned_dir}/.claude-settings.owned.XXXXXX")" || {
    rmdir "${lock_dir}"
    return 1
  }
  # Union with whatever another run published since this one read the ledger.
  local sources=("${owned_next_file}")
  if [[ -s "${owned_file}" ]] && jq -e 'type == "object"' "${owned_file}" >/dev/null 2>&1; then
    sources+=("${owned_file}")
  fi
  if jq -s '
      def union($field): map(.[$field] // {})
        | reduce .[] as $part ({}; reduce ($part | to_entries[]) as $e (.; .[$e.key] = ((.[$e.key] // []) + $e.value | unique)));
      {keys: union("keys"), hooks: union("hooks")}
    ' "${sources[@]}" >"${staged}" &&
    mv "${staged}" "${owned_file}"; then
    rmdir "${lock_dir}"
    return 0
  fi
  rm -f "${staged}"
  rmdir "${lock_dir}"
  return 1
}

if [[ ! -s "${live_file}" ]]; then
  if command -v jq >/dev/null 2>&1; then
    record_ownership
  fi
  cat "${managed_file}"
  exit 0
fi

# Failing leaves the existing file untouched; emitting managed JSON here would erase it.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "claude settings.json: jq not found; leaving the existing file unchanged." >&2
  exit 1
fi
if ! jq -e 'type == "object"' "${live_file}" >/dev/null 2>&1; then
  printf '%s\n' "claude settings.json: existing file is not a JSON object; fix or delete it, then re-apply." >&2
  exit 1
fi

record_ownership

jq -n \
  --slurpfile live "${live_file}" \
  --slurpfile managed "${managed_file}" \
  --slurpfile owned "${owned_next_file}" '
  def at($path): try getpath($path) catch null;
  $managed[0] as $m
  | $owned[0] as $o
  # Retire owned keys the template dropped whose live value is still one the template set.
  | [$o.keys | to_entries[] | (.key | fromjson) as $k | .value as $values
      | select(($m | at($k)) == null)
      | ($live[0] | at($k)) as $v
      | select($v != null and any($values[]; . == $v))
      | $k] as $gone
  | ($live[0] | delpaths($gone))
  # Retire owned hook groups the template no longer has.
  | reduce ($o.hooks | to_entries[]) as $event (.;
      if (.hooks[$event.key] | type) == "array" then
        .hooks[$event.key] |= map(. as $group
          | select((any($event.value[]; . == $group) and (any(($m.hooks[$event.key] // [])[]; . == $group) | not)) | not))
      else . end)
  | . as $l
  | ($l * $m)
  | .hooks = (
      reduce (($l.hooks // {}) | to_entries[] | select(.value | type == "array")) as $event
        (($m.hooks // {});
          (.[$event.key] // []) as $base
          | .[$event.key] = $base + [$event.value[] as $group | select(any($base[]; . == $group) | not) | $group]
        )
    )
' >"${merged_file}"

if jq -e -n --slurpfile a "${live_file}" --slurpfile b "${merged_file}" '$a[0] == $b[0]' >/dev/null; then
  cat "${live_file}"
else
  cat "${merged_file}"
fi
