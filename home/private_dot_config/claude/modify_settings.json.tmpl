#!/usr/bin/env bash
set -euo pipefail

# Claude Code and other tools (moshi-hook, /model, /plugin) write into settings.json and
# reorder its keys. Template-defined keys win; everything else in the live file is kept, and
# hook groups added by other tools are appended to the managed ones. When the merge changes
# nothing but key order, the live file is passed through untouched so `chezmoi diff` stays clean.
#
# Keys and hook groups the template managed at the last apply (snapshot written by
# run_onchange_after_claude-settings-snapshot) but no longer defines are removed when the live
# file still holds the old value, so retired plugins and replaced hooks don't linger.

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

managed_file="${tmp_dir}/managed.json"
live_file="${tmp_dir}/live.json"
merged_file="${tmp_dir}/merged.json"
snapshot_file="${CLAUDE_SETTINGS_SNAPSHOT:-{{ template "claude_code_settings_snapshot_path.tmpl" . }}}"
previous_file="${tmp_dir}/previous.json"

cat >"${managed_file}" <<'CLAUDE_SETTINGS_JSON'
{{ includeTemplate "claude_code_settings.json.tmpl" . | trim }}
CLAUDE_SETTINGS_JSON

cat >"${live_file}"

if [[ ! -s "${live_file}" ]]; then
  cat "${managed_file}"
  exit 0
fi

# Failing leaves the existing file untouched; emitting managed JSON here would erase it.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "claude settings.json: jq not found; leaving the existing file unchanged." >&2
  exit 1
fi
if ! jq -e 'type == "object"' "${live_file}" >/dev/null 2>&1; then
  printf '%s\n' "claude settings.json: existing file is not a JSON object; fix or delete it, then re-apply." >&2
  exit 1
fi

if [[ -s "${snapshot_file}" ]] && jq -e 'type == "object"' "${snapshot_file}" >/dev/null 2>&1; then
  cat "${snapshot_file}" >"${previous_file}"
else
  printf '{}\n' >"${previous_file}"
fi

jq -n \
  --slurpfile live "${live_file}" \
  --slurpfile managed "${managed_file}" \
  --slurpfile previous "${previous_file}" '
  def at($path): try getpath($path) catch null;
  $managed[0] as $m
  | $previous[0] as $p
  # Retire non-hook keys the last apply managed, the template dropped, and nobody edited since.
  | [$p | paths(type != "object") | select(all(.[]; type == "string")) | select(.[0] != "hooks")] as $prevKeys
  | [$prevKeys[] as $k | select(($m | at($k)) == null and ($live[0] | at($k)) == ($p | at($k))) | $k] as $gone
  | ($live[0] | delpaths($gone))
  # Retire hook groups the last apply managed that the template no longer has.
  | reduce (($p.hooks // {}) | to_entries[] | select(.value | type == "array")) as $event (.;
      if (.hooks[$event.key] | type) == "array" then
        .hooks[$event.key] |= map(. as $group
          | select((any($event.value[]; . == $group) and (any(($m.hooks[$event.key] // [])[]; . == $group) | not)) | not))
      else . end)
  | . as $l
  | ($l * $m)
  | .hooks = (
      reduce (($l.hooks // {}) | to_entries[] | select(.value | type == "array")) as $event
        (($m.hooks // {});
          (.[$event.key] // []) as $base
          | .[$event.key] = $base + [$event.value[] as $group | select(any($base[]; . == $group) | not) | $group]
        )
    )
' >"${merged_file}"

if jq -e -n --slurpfile a "${live_file}" --slurpfile b "${merged_file}" '$a[0] == $b[0]' >/dev/null; then
  cat "${live_file}"
else
  cat "${merged_file}"
fi
