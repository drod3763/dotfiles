  "brew@agentic-tools" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/agentic-tools/brew/9f582fcb4322" | join "") "version" "9f582fcb4322" "installedAt" "2026-05-14T19:27:38.806Z" "lastUpdated" "2026-05-23T03:53:34.802Z" "gitCommitSha" "461fae051db15a65bfca58a9cf649682f40d307b")
