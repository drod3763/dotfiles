{{/* chezmoi:modify-template */}}
{{- $current := dict -}}
{{- $stdin := get .chezmoi "stdin" -}}
{{- if $stdin -}}
  {{- $current = $stdin | fromJson -}}
{{- end -}}
{{- $modified := deepCopy $current -}}
{{- if not (hasKey $modified "version") -}}
  {{- $_ := set $modified "version" 2 -}}
{{- end -}}
{{- $currentPlugins := get $current "plugins" | default (dict) -}}
{{- $plugins := get $modified "plugins" | default (dict) -}}
{{- $_ := set $modified "plugins" $plugins -}}
{{- $pluginManifest := includeTemplate "claude_code_plugin_renderer.tmpl" . | mustFromJson -}}
{{- $activeSeeds := get $pluginManifest "install_seeds" | default (dict) -}}
{{- $ownedMarketplaces := get $pluginManifest "owned_marketplaces" | default (list) -}}
{{- range (keys $plugins | sortAlpha | uniq) -}}
  {{- $name := . -}}
  {{- $parts := splitList "@" $name -}}
  {{- if eq (len $parts) 2 -}}
    {{- $marketplace := index $parts 1 -}}
    {{- $installedList := get $plugins $name | default (list) -}}
    {{- $installedPlugin := dict -}}
    {{- if gt (len $installedList) 0 -}}
      {{- $installedPlugin = index $installedList 0 -}}
    {{- end -}}
    {{- $scope := get $installedPlugin "scope" | default "" -}}
    {{- if and (eq $scope "user") (has $marketplace $ownedMarketplaces) (not (hasKey $activeSeeds $name)) -}}
      {{- $_ := unset $plugins $name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range (keys $activeSeeds | sortAlpha | uniq) -}}
  {{- $name := . -}}
  {{- $managedPlugin := deepCopy (get $activeSeeds $name) -}}
  {{- $currentPlugin := dict -}}
  {{- $currentList := get $currentPlugins $name | default (list) -}}
  {{- if gt (len $currentList) 0 -}}
    {{- $currentPlugin = index $currentList 0 -}}
    {{- range $field := list "installPath" "version" "gitCommitSha" "installedAt" "lastUpdated" -}}
      {{- if hasKey $currentPlugin $field -}}
        {{- $_ := set $managedPlugin $field (get $currentPlugin $field) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set $plugins $name (list $managedPlugin) -}}
{{- end -}}
{{- if deepEqual $current $modified -}}
{{ $stdin }}
{{- else -}}
{{ $modified | toPrettyJson }}
{{- end -}}
