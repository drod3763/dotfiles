{{/* chezmoi:modify-template */}}
{{- $current := dict -}}
{{- $stdin := get .chezmoi "stdin" -}}
{{- if $stdin -}}
  {{- $current = $stdin | fromJson -}}
{{- end -}}
{{- $modified := deepCopy $current -}}
{{- $_ := "" -}}
{{- $timestamp := dateInZone "2006-01-02T15:04:05.000Z" now "UTC" -}}
{{- if not (hasKey $modified "version") -}}
  {{- $_ = set $modified "version" 2 -}}
{{- end -}}
{{- $currentPlugins := get $current "plugins" | default (dict) -}}
{{- $plugins := get $modified "plugins" | default (dict) -}}
{{- $_ = set $modified "plugins" $plugins -}}
{{- if .personal -}}
  {{- $_ = unset $plugins "slack@claude-plugins-official" -}}
  {{- $_ = unset $plugins "csharp-lsp@claude-plugins-official" -}}
{{- else -}}
  {{- $_ = unset $plugins "cloudflare@cloudflare" -}}
  {{- $_ = unset $plugins "truenas-extras@agentic-tools" -}}
{{- end -}}
{{- $_ = unset $plugins "telegram@claude-plugins-official" -}}
