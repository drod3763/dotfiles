{{- if not .personal -}}
  {{- $_ = set $managed "slack@claude-plugins-official" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/claude-plugins-official/slack/1.0.0" | join "") "version" "1.0.0" "installedAt" "2026-04-06T19:07:03.385Z" "lastUpdated" "2026-04-06T19:07:03.385Z" "gitCommitSha" "7b9458950d38bb01ddb48b669f9fa89bcdfd98b8") -}}
