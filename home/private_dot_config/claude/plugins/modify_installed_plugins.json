{{- end -}}
{{- if .personal -}}
  {{- $_ = set $managed "cloudflare@cloudflare" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/cloudflare/cloudflare/1.0.0" | join "") "version" "1.0.0" "installedAt" "2026-05-04T03:56:03.542Z" "lastUpdated" "2026-05-04T03:56:03.542Z" "gitCommitSha" "7c449def4e0c63daa27212d853094e4c8e37bbe8") -}}
{{- end -}}
{{- range $name, $managedPlugin := $managed -}}
  {{- $currentPlugin := dict -}}
  {{- $currentList := get $currentPlugins $name | default (list) -}}
  {{- if gt (len $currentList) 0 -}}
    {{- $currentPlugin = index $currentList 0 -}}
    {{- range $field := list "installPath" "version" "gitCommitSha" "installedAt" "lastUpdated" -}}
      {{- if hasKey $currentPlugin $field -}}
        {{- $_ = set $managedPlugin $field (get $currentPlugin $field) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $_ = set $plugins $name (list $managedPlugin) -}}
{{- end -}}
{{- if deepEqual $current $modified -}}
{{ $stdin }}
{{- else -}}
{{ $modified | toPrettyJson }}
{{- end -}}
