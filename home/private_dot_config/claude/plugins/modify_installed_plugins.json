  "imessage@claude-plugins-official" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/claude-plugins-official/imessage/0.1.0" | join "") "version" "0.1.0" "installedAt" "2026-04-06T18:04:58.261Z" "lastUpdated" "2026-04-06T18:04:58.261Z" "gitCommitSha" "104d39be10b7b1380b2ae23a387a11a297b599c3")
