  "homebrew-formula-cask@agentic-tools" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/agentic-tools/homebrew-formula-cask/1.0.0" | join "") "version" "1.0.0" "installedAt" "2026-05-08T05:57:41.334Z" "lastUpdated" "2026-05-08T05:57:41.334Z" "gitCommitSha" "5dc90dae679d9fb5b9332ebd0a6da9927f17390b")
