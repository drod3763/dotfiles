  {{- $_ = set $managed "csharp-lsp@claude-plugins-official" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/claude-plugins-official/csharp-lsp/1.0.0" | join "") "version" "1.0.0" "installedAt" "2026-04-17T20:21:05.183Z" "lastUpdated" "2026-04-17T20:21:05.183Z" "gitCommitSha" "104d39be10b7b1380b2ae23a387a11a297b599c3") -}}
