  {{- $_ = set $managed "truenas-extras@agentic-tools" (dict "scope" "user" "installPath" (list .chezmoi.homeDir "/.config/claude/plugins/cache/agentic-tools/truenas-extras/1.0.0" | join "") "version" "1.0.0" "installedAt" "2026-05-08T05:58:07.162Z" "lastUpdated" "2026-05-08T05:58:07.162Z" "gitCommitSha" "5dc90dae679d9fb5b9332ebd0a6da9927f17390b") -}}
{{- end -}}
{{- range $name, $managedPlugin := $managed -}}
  {{- $currentPlugin := dict -}}
  {{- $currentList := get $currentPlugins $name | default (list) -}}
  {{- if gt (len $currentList) 0 -}}
    {{- $currentPlugin = index $currentList 0 -}}
  {{- end -}}
  {{- $_ = set $managedPlugin "installedAt" (get $currentPlugin "installedAt" | default $timestamp) -}}
  {{- $_ = set $managedPlugin "lastUpdated" (get $currentPlugin "lastUpdated" | default $timestamp) -}}
  {{- $_ = set $plugins $name (list $managedPlugin) -}}
{{- end -}}
{{- if deepEqual $current $modified -}}
{{ $stdin }}
{{- else -}}
{{ $modified | toPrettyJson }}
{{- end -}}
